# ViceHub X — Configuration Apache / LiteSpeed (O2Switch)
# La racine web pointe sur ce dossier ; index.php est le point d'entrée.

DirectoryIndex index.php
Options -Indexes
AddDefaultCharset UTF-8

# --- Sécurité : on bloque l'accès HTTP aux dossiers internes ---
# (PHP continue de les inclure côté serveur ; seul l'accès direct est interdit.)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Forcer le HTTPS (tout le trafic passe en https://) ---
    # ⚠️ N'active vraiment cette redirection qu'APRÈS avoir activé AutoSSL en cPanel
    #    (certificat en place). Sinon le site redirigerait vers un HTTPS non prêt.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:X-Forwarded-SSL}   !on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Déploiement Git : on interdit l'accès web au dossier .git et fichiers Git
    RewriteRule (^|/)\.git - [F,L]
    RewriteRule ^(config|database|includes|scripts|scripts-python|agents|seo|lang)/ - [F,L]
    # robots.txt & sitemap.xml dynamiques (Sitemap en URL absolue pour Google)
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # ======================================================================
    #  URL PROPRES (sans /pages/ ni .php)
    # ======================================================================
    # 1) Redirections 301 des anciennes URL vers les URL propres (SEO).
    #    a) Contenus dynamiques (on garde le slug/id) — AVANT la règle générique.
    RewriteCond %{THE_REQUEST} \s/+pages/article\.php\?slug=([a-z0-9-]+) [NC]
    RewriteRule ^ /article/%1? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+pages/product\.php\?slug=([a-z0-9-]+) [NC]
    RewriteRule ^ /produit/%1? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+pages/forum-thread\.php\?id=([0-9]+) [NC]
    RewriteRule ^ /sujet/%1? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+pages/forum-category\.php\?cat=([a-z0-9-]+) [NC]
    RewriteRule ^ /categorie/%1? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+pages/profil\.php\?u=([a-zA-Z0-9_.-]+) [NC]
    RewriteRule ^ /membre/%1? [R=301,L]
    #    b) Accueil + pages simples.
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^ / [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+pages/([a-z0-9-]+)\.php([\s?]) [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 2) URL « parlantes » pour les contenus dynamiques.
    RewriteRule ^article/([a-z0-9-]+)/?$   pages/article.php?slug=$1        [QSA,L]
    RewriteRule ^produit/([a-z0-9-]+)/?$   pages/product.php?slug=$1        [QSA,L]
    RewriteRule ^sujet/([0-9]+)/?$         pages/forum-thread.php?id=$1     [QSA,L]
    RewriteRule ^categorie/([a-z0-9-]+)/?$ pages/forum-category.php?cat=$1  [QSA,L]
    RewriteRule ^membre/([a-zA-Z0-9_.-]+)/?$ pages/profil.php?u=$1          [QSA,L]

    # 3) Page simple : /news → pages/news.php (uniquement si la page existe).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f
    RewriteRule ^([a-z0-9-]+)/?$ pages/$1.php [QSA,L]
</IfModule>

# --- Sécurité : fichiers sensibles inaccessibles depuis le web ---
<FilesMatch "(^\.|\.(env|sql|sh|log|ini|md|lock|json|yml|yaml)$)">
    Require all denied
</FilesMatch>
# On laisse passer les manifestes utiles éventuels (décommentez si besoin)
# <Files "site.webmanifest">
#     Require all granted
# </Files>

# --- Cache des assets statiques ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png            "access plus 30 days"
    ExpiresByType image/jpeg           "access plus 30 days"
    ExpiresByType image/webp           "access plus 30 days"
    ExpiresByType video/mp4            "access plus 30 days"
    ExpiresByType text/css             "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# --- En-têtes de sécurité ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # STAGING UNIQUEMENT : décommentez sur le sous-domaine de préversion
    # pour empêcher l'indexation Google. À NE PAS activer en production.
    # Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

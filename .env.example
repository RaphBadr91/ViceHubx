# ViceHub X — Variables d'environnement
# Copiez ce fichier en « .env » sur le serveur et remplissez vos valeurs.
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).

# --- Environnement ---
# « prod » masque les erreurs PHP aux visiteurs. « dev » les affiche.
APP_ENV=prod

# URL de base du site (sans slash final). Vide = racine du domaine.
# Ex. https://vicehubx.fr   ou   https://dev.vicehubx.fr
VICEHUB_BASE_URL=

# --- Base de données (identifiants cPanel / O2Switch) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moncompte_vicehubx
DB_USER=moncompte_vice
DB_PASS=motdepasse-fort-ici

# --- Sécurité ---
# Clé secrète CSRF : générez une longue chaîne aléatoire unique.
VICEHUB_CSRF_KEY=remplacez-par-une-longue-chaine-aleatoire
